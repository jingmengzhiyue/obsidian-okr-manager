{
	"name": "vault-okr-manager",
	"version": "1.3.0",
	"description": "Manage OKRs inside your vault with a streamlined dashboard and built-in check-ins.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import jiti/register --test tests/okr-utils.test.mjs tests/okr-period.test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0"
	},
	"keywords": [],
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.20.1",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	}
}
